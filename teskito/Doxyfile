# Doxygen configuration for the Teskito SDL task.

PROJECT_NAME           = "Teskito Background Task"
PROJECT_BRIEF          = "SDL background scrolling task with idle, run, and jump animation"
OUTPUT_DIRECTORY       = docs
OUTPUT_LANGUAGE        = English

FULL_PATH_NAMES        = NO
STRIP_FROM_PATH        = .
MARKDOWN_SUPPORT       = YES
USE_MDFILE_AS_MAINPAGE = README.md

INPUT                  = README.md \
                         main.c \
                         fonctions.c \
                         headers.h

FILE_PATTERNS          = *.c \
                         *.h \
                         *.md

RECURSIVE              = NO

EXTRACT_ALL            = YES
EXTRACT_STATIC         = YES
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
JAVADOC_AUTOBRIEF      = YES
QT_AUTOBRIEF           = YES
MULTILINE_CPP_IS_BRIEF = YES

ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
SKIP_FUNCTION_MACROS   = YES

GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_TREEVIEW      = YES
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO

GENERATE_LATEX         = NO
GENERATE_XML           = NO
GENERATE_MAN           = NO

WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_AS_ERROR          = NO
QUIET                  = NO

HAVE_DOT               = NO
CALL_GRAPH             = NO
CALLER_GRAPH           = NO
