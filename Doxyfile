# Doxygen configuration for the SDL game project.

PROJECT_NAME           = "Home Adventure SDL Game"
PROJECT_BRIEF          = "SDL game with menu scenes, playable levels, shop minigames, saves, and online lobby support"
OUTPUT_DIRECTORY       = docs/doxygen
CREATE_SUBDIRS         = NO
OUTPUT_LANGUAGE        = English

FULL_PATH_NAMES        = NO
STRIP_FROM_PATH        = .
MARKDOWN_SUPPORT       = YES
USE_MDFILE_AS_MAINPAGE = docs/mainpage.md

INPUT                  = docs/mainpage.md \
                         docs/architecture.md \
                         src \
                         lvls/shared \
                         lvls/level1-climb \
                         lvls/level2-chase \
                         lvls/level3-hell \
                         lvls/level4-pool \
                         lvls/newshoplvl1 \
                         option/src

FILE_PATTERNS          = *.c \
                         *.h \
                         *.md

RECURSIVE              = YES
EXCLUDE                = "lvls/newshoplvl1/arcade mini games"
EXCLUDE_PATTERNS       = */assets/* \
                         */build/* \
                         */output/* \
                         */saves/* \
                         */tests/* \
                         */.git/*

EXTRACT_ALL            = YES
EXTRACT_STATIC         = NO
EXTRACT_LOCAL_CLASSES  = NO
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
JAVADOC_AUTOBRIEF      = YES
QT_AUTOBRIEF           = YES
MULTILINE_CPP_IS_BRIEF = YES

ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = NO
SKIP_FUNCTION_MACROS   = YES
PREDEFINED             = MERGED_BUILD

INCLUDE_PATH           = src/main_menu \
                         src/options \
                         src/load \
                         src/choose \
                         src/top_scores \
                         src/enigma \
                         src/ui \
                         src/debug \
                         src/game \
                         src/online \
                         lvls/shared \
                         lvls/newshoplvl1

GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_DYNAMIC_SECTIONS  = YES
GENERATE_TREEVIEW      = YES
DISABLE_INDEX          = NO
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES

GENERATE_LATEX         = NO
GENERATE_XML           = NO
GENERATE_MAN           = NO

WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_AS_ERROR          = NO
QUIET                  = NO

HAVE_DOT               = NO
CALL_GRAPH             = NO
CALLER_GRAPH           = NO
